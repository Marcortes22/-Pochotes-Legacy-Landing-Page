<a
  id="fab"
  href={waLink}
  target="_blank"
  rel="noopener"
  aria-label={t.nav.fab}
  class="fixed bottom-5 right-5 z-30 grid size-14 place-items-center rounded-full bg-forest text-cream shadow-xl shadow-forest/40"
>
  <span class="ping absolute inset-0 rounded-full bg-forest" aria-hidden="true"
  ></span>
  <svg
    viewBox="0 0 24 24"
    class="relative size-7"
    fill="currentColor"
    aria-hidden="true"><path d={waIcon}></path></svg
  >
</a>

<style is:global>
  .car-pad {
    --sw: 84vw;
    padding-inline: calc((100% - var(--sw)) / 2);
  }
  .car-slide {
    width: var(--sw);
  }
  @media (min-width: 768px) {
    .car-pad {
      --sw: min(56vw, 900px);
    }
  }
  dialog[open] {
    animation: rise 0.4s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const touch = matchMedia('(hover: none)').matches;

  // Reveal on scroll
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      }),
    { threshold: 0.12, rootMargin: '0px 0px -5% 0px' },
  );
  document
    .querySelectorAll('[data-reveal]')
    .forEach((el) => (reduce ? el.classList.add('is-in') : io.observe(el)));

  // Hero counters
  if (!reduce) {
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const end = Number(el.dataset.count);
      const t0 = performance.now() + 1200;
      el.textContent = '0';
      const tick = (now: number) => {
        const p = Math.min(Math.max((now - t0) / 1000, 0), 1);
        el.textContent = String(Math.round(end * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  }

  // Scroll progress, hero parallax, floating WhatsApp button
  const bar = document.getElementById('progress')!;
  const para = document.querySelector<HTMLElement>('.parallax');
  const fab = document.getElementById('fab')!;
  const contact = document.getElementById('contacto')!;
  let nearContact = false;
  new IntersectionObserver(([e]) => (nearContact = e.isIntersecting), {
    threshold: 0.2,
  }).observe(contact);
  let ticking = false;
  const update = () => {
    const max = document.documentElement.scrollHeight - innerHeight;
    bar.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
    if (para && !reduce && scrollY < innerHeight * 1.2)
      para.style.setProperty(
        '--py',
        `${scrollY * Number(para.dataset.speed)}px`,
      );
    fab.classList.toggle('show', scrollY > innerHeight * 0.8 && !nearContact);
    ticking = false;
  };
  addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true },
  );
  update();

  // Card spotlight (mouse) and centre-of-screen focus (touch)
  document.querySelectorAll<HTMLElement>('.card').forEach((c) =>
    c.addEventListener('pointermove', (e) => {
      const r = c.getBoundingClientRect();
      c.style.setProperty('--mx', `${e.clientX - r.left}px`);
      c.style.setProperty('--my', `${e.clientY - r.top}px`);
    }),
  );
  if (touch) {
    const focusIO = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) =>
          e.target.classList.toggle('in-focus', e.isIntersecting),
        ),
      { rootMargin: '-40% 0px -40% 0px' },
    );
    document
      .querySelectorAll('.card, .frame-host')
      .forEach((el) => focusIO.observe(el));
  }

  // Rent tabs
  const tablist = document.querySelector<HTMLElement>('[role="tablist"]')!;
  const tabs = Array.from(
    tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
  );
  const selectTab = (i: number, focus = false) => {
    tablist.dataset.active = String(i);
    tabs.forEach((tb, k) => {
      const on = k === i;
      tb.setAttribute('aria-selected', String(on));
      tb.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(tb.getAttribute('aria-controls')!)!;
      panel.hidden = !on;
      if (on) {
        panel.classList.remove('enter');
        void panel.offsetWidth;
        panel.classList.add('enter');
      }
    });
    if (focus) tabs[i].focus();
  };
  tabs.forEach((tb, i) => {
    tb.addEventListener('click', () => selectTab(i));
    tb.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        selectTab(
          (i + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length,
          true,
        );
      }
    });
  });

  // Gallery carousel
  const dlg = document.getElementById('lightbox') as HTMLDialogElement;
  const big = document.getElementById('lightbox-img') as HTMLImageElement;
  const track = document.getElementById('car-track')!;
  const slides = Array.from(track.querySelectorAll<HTMLElement>('.car-slide'));
  const now = document.getElementById('car-now')!;
  const barEl = document.getElementById('car-bar')!;
  let cur = 0;
  const go = (i: number) => {
    const s = slides[(i + slides.length) % slides.length];
    track.scrollTo({
      left: s.offsetLeft - (track.clientWidth - s.clientWidth) / 2,
      behavior: reduce ? 'auto' : 'smooth',
    });
  };
  const mark = () => {
    const mid = track.scrollLeft + track.clientWidth / 2;
    let best = 0,
      dist = Infinity;
    slides.forEach((s, i) => {
      const d = Math.abs(s.offsetLeft + s.clientWidth / 2 - mid);
      if (d < dist) {
        dist = d;
        best = i;
      }
    });
    cur = best;
    slides.forEach((s, i) => s.classList.toggle('is-active', i === best));
    now.textContent = String(best + 1);
    barEl.style.transform = `scaleX(${(best + 1) / slides.length})`;
  };
  track.addEventListener('scroll', () => requestAnimationFrame(mark), {
    passive: true,
  });
  let lastTouch = 0;
  const hold = () => (lastTouch = Date.now());
  ['pointerdown', 'wheel', 'touchmove'].forEach((ev) =>
    track.addEventListener(ev, hold, { passive: true }),
  );
  document.getElementById('car-prev')!.addEventListener('click', () => {
    hold();
    go(cur - 1);
  });
  document.getElementById('car-next')!.addEventListener('click', () => {
    hold();
    go(cur + 1);
  });
  track.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') {
      e.preventDefault();
      hold();
      go(cur + 1);
    }
    if (e.key === 'ArrowLeft') {
      e.preventDefault();
      hold();
      go(cur - 1);
    }
  });
  mark();
  if (!reduce) {
    let hovering = false,
      visible = false;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting), {
      threshold: 0.1,
    }).observe(track);
    track.addEventListener(
      'pointerenter',
      (e) => (hovering = e.pointerType === 'mouse'),
    );
    track.addEventListener('pointerleave', () => (hovering = false));
    setInterval(() => {
      if (visible && !hovering && !dlg.open && Date.now() - lastTouch > 4000)
        go(cur + 1);
    }, 3500);
  }

  // Lightbox
  document.querySelectorAll<HTMLButtonElement>('.gallery-btn').forEach((b) =>
    b.addEventListener('click', () => {
      const img = b.querySelector('img')!;
      big.src = img.currentSrc || img.src;
      big.alt = img.alt;
      dlg.showModal();
    }),
  );
  dlg.addEventListener('click', (e) => {
    if (e.target === dlg) dlg.close();
  });
</script>
