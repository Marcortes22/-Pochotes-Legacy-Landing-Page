---
import Header from './Header.astro';
import HeroSection from './landing/HeroSection.astro';
import Ribbon from './landing/Ribbon.astro';
import IntroSection from './landing/IntroSection.astro';
import HouseSection from './landing/HouseSection.astro';
import RentSection from './landing/RentSection.astro';
import ExperiencesSection from './landing/ExperiencesSection.astro';
import GallerySection from './landing/GallerySection.astro';
import LocationSection from './landing/LocationSection.astro';
import SoonSection from './landing/SoonSection.astro';
import ContactSection from './landing/ContactSection.astro';
import SiteFooter from './landing/SiteFooter.astro';
import WhatsAppFab from './landing/WhatsAppFab.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<div id="progress" aria-hidden="true"></div>
<Header locale={locale} />

<main class="relative overflow-x-clip">
  <HeroSection locale={locale} />
  <Ribbon locale={locale} />
  <IntroSection locale={locale} />
  <HouseSection locale={locale} />
  <RentSection locale={locale} />
  <ExperiencesSection locale={locale} />
  <GallerySection locale={locale} />
  <LocationSection locale={locale} />
  <SoonSection locale={locale} />
  <ContactSection locale={locale} />
</main>

<SiteFooter locale={locale} />
<WhatsAppFab locale={locale} />

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const touch = matchMedia('(hover: none)').matches;

  // Reveal on scroll
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      }),
    { threshold: 0.12, rootMargin: '0px 0px -5% 0px' },
  );
  document
    .querySelectorAll('[data-reveal]')
    .forEach((el) => (reduce ? el.classList.add('is-in') : io.observe(el)));

  // Scroll progress, hero parallax, floating WhatsApp button
  const bar = document.getElementById('progress')!;
  const para = document.querySelector<HTMLElement>('.parallax');
  const fab = document.getElementById('fab')!;
  const contact = document.getElementById('contacto')!;
  let nearContact = false;
  new IntersectionObserver(([e]) => (nearContact = e.isIntersecting), {
    threshold: 0.2,
  }).observe(contact);
  let ticking = false;
  const update = () => {
    const max = document.documentElement.scrollHeight - innerHeight;
    bar.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
    if (para && !reduce && scrollY < innerHeight * 1.2)
      para.style.setProperty(
        '--py',
        `${scrollY * Number(para.dataset.speed)}px`,
      );
    fab.classList.toggle('show', scrollY > innerHeight * 0.8 && !nearContact);
    ticking = false;
  };
  addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true },
  );
  update();

  // Card spotlight (mouse) and centre-of-screen focus on photo frames (touch)
  document.querySelectorAll<HTMLElement>('.card').forEach((c) =>
    c.addEventListener('pointermove', (e) => {
      const r = c.getBoundingClientRect();
      c.style.setProperty('--mx', `${e.clientX - r.left}px`);
      c.style.setProperty('--my', `${e.clientY - r.top}px`);
    }),
  );
  if (touch) {
    const focusIO = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) =>
          e.target.classList.toggle('in-focus', e.isIntersecting),
        ),
      { rootMargin: '-40% 0px -40% 0px' },
    );
    document
      .querySelectorAll('.frame-host')
      .forEach((el) => focusIO.observe(el));
  }
</script>
