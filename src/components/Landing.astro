        <h2 class="h-line text-[2.1rem] md:text-6xl">{t.form.title}</h2>
        <p class="mt-5 text-lg">{t.form.lead}</p>
        <ul class="mt-7 grid gap-3 sm:grid-cols-2 md:grid-cols-1">
          <li>
