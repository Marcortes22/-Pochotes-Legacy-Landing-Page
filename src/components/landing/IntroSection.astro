---
import { Image } from 'astro:assets';
import { ui, type Locale } from '../../i18n/ui';
import terrazaVertical from '../../assets/images/terraza-vertical.jpeg';
import { wrap } from './shared';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
---

<section
  id="intro"
  class={`${wrap} relative grid items-center gap-10 pb-6 pt-6 md:grid-cols-12 md:pb-10 md:pt-12`}
>
  <div class="blob -left-24 top-0 size-80 bg-sand"></div>
  <div class="md:col-span-7 md:pr-6" data-reveal="left">
    <h2 class="h-line text-[2.1rem] md:text-6xl">{t.intro.title}</h2>
    <p class="mt-6 max-w-prose text-lg">{t.intro.p1}</p>
    <p class="mt-4 max-w-prose">{t.intro.p2}</p>
  </div>
  <div class="hidden md:col-span-5 md:block">
    <div class="frame-host scroll-zoom relative" data-reveal="zoom">
      <Image
        src={terrazaVertical}
        alt={t.intro.alt}
        width={800}
        widths={[480, 800]}
        sizes="40vw"
        class="aspect-[5/4] w-full object-cover shadow-2xl shadow-forest/25 lg:aspect-[4/3]"
      />
      <span class="frame" aria-hidden="true"></span>
    </div>
  </div>
</section>
