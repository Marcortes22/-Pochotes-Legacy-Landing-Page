---
import { ArrowRight } from '@lucide/astro';
import Logo from '../Logo.astro';
import { ui, type Locale } from '../../i18n/ui';
import { wrap } from './shared';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
---

<section
  id="proximamente"
  class="grain relative isolate mx-3 overflow-hidden bg-sand panel md:mx-8"
>
  <div
    class={`${wrap} grid items-center gap-8 py-12 md:grid-cols-12 md:py-16`}
  >
    <div class="md:col-span-8" data-reveal="left">
      <p
        class="inline-flex items-center gap-2 rounded-full border border-forest px-3 py-1 font-mono text-xs font-medium"
      >
        <span class="relative flex size-2"
          ><span
            class="absolute inline-flex size-full animate-ping rounded-full bg-forest opacity-60"
          ></span><span
            class="relative inline-flex size-2 rounded-full bg-forest"
          ></span></span
        >
        {t.soon.badge}
      </p>
      <h2 class="h-line mt-5 text-[2.1rem] md:text-6xl">{t.soon.title}</h2>
      <p class="mt-5 max-w-prose text-lg">{t.soon.p1}</p>
      <p class="mt-3 max-w-prose">{t.soon.p2}</p>
      <a href="#contacto" class="btn btn-shine mt-6 bg-forest text-cream"
        >{t.soon.cta}<ArrowRight class="size-5" aria-hidden="true" /></a
      >
    </div>
    <div
      class="hidden justify-self-center md:col-span-4 md:block"
      data-reveal="zoom"
    >
      <div class="relative grid size-64 place-items-center">
        <span class="ring-pulse"></span><span
          class="ring-pulse"
          style="animation-delay:-2s"></span><span
          class="ring-pulse"
          style="animation-delay:-4s"></span>
        <Logo class="float relative h-44 w-auto text-forest" />
      </div>
    </div>
  </div>
  <Logo
    class="pointer-events-none absolute -bottom-6 -right-4 -z-10 h-40 w-auto text-forest/15 md:hidden"
  />
</section>
